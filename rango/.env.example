# Porta do servidor HTTP
PORT=4000

# Segredo para assinar os tokens de sessão (troque por um valor aleatório em produção).
# Se ficar vazio, o Lpoint gera e salva um automaticamente em data/.secret
LPOINT_SECRET=

# Duração padrão de cada reserva em minutos (usada em novos restaurantes)
DEFAULT_SLOT_MINUTES=90

# Caminho do banco SQLite (opcional). Padrão: data/lpoint.db
# LPOINT_DB=/caminho/para/lpoint.db

# Acesso rápido de demonstração (botão "Ver sem senha"). Defina 0 para DESATIVAR em produção.
LPOINT_DEMO=1
