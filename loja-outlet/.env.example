# Banco PostgreSQL (Supabase/Neon). DATABASE_URL pode ser a URL com pooler; DIRECT_URL é a conexão direta (migrations).
DATABASE_URL=
DIRECT_URL=

# Segredo para assinar sessões (mín. 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=

# URL pública da loja (sem barra final). Ex.: https://loja.vercel.app
BASE_URL=

# Mercado Pago (opcional até configurar o pagamento)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Supabase Storage (upload de imagens). Bucket público; a service role fica SOMENTE no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=loja

# Usado só pelo script `npm run admin:create` (não é lido pela aplicação)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# E-mail transacional (recuperação de senha) — Resend. Sem isso o e-mail de recuperação NÃO é enviado.
RESEND_API_KEY=
MAIL_FROM=

# Vercel Cron (Authorization: Bearer CRON_SECRET) — expira pedidos não pagos
CRON_SECRET=
