# ---- Públicas (podem ir para o navegador) ----
NEXT_PUBLIC_SUPABASE_URL=
# Chave "anon" (ou "publishable") do Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública do site (sem barra final). Usada em sitemap, canonical e links de e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SECRETAS (somente servidor — NUNCA use o prefixo NEXT_PUBLIC_) ----
# Chave service_role / secret do Supabase. Usada apenas em: criar pedido e painel master.
SUPABASE_SERVICE_ROLE_KEY=
